{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/cli/index.ts",
    "src/config.ts",
    "src/types.ts"
  ],
  "entryPointStrategy": "resolve",
  "tsconfig": "tsconfig.json",
  "out": "docs",
  "name": "Agente S696",
  "includeVersion": true,
  "readme": "README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "categorizeByGroup": true,
  "highlightLanguages": [
    "bash",
    "json",
    "markdown",
    "mermaid",
    "powershell",
    "sql",
    "typescript"
  ],
  "sort": ["source-order"],
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  }
}
