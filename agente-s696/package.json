{
  "name": "agente-s696",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de geração de massa de dados para o schema adm",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/cli.js",
    "conhecimento": "node dist/conhecimento.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "node tests/integration/require-test-database.cjs && jest --runInBand tests/integration"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "csv-parse": "^7.0.3",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typedoc": "0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
